# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# CONFIGURATION OFFICIELLE FACEBOOK & META
# ==========================================
# URL de la page Facebook officielle (ex: https://www.facebook.com/LeBerceauDes3S)
VITE_FACEBOOK_PAGE_URL="https://www.facebook.com/LeBerceauDes3S"

# ID numérique de la Page Facebook (trouvé sur la page Facebook > À propos > Transparence de la Page ou Meta Business Suite)
META_PAGE_ID=""

# Jeton d'accès Page longue durée (Page Access Token - généré depuis Meta for Developers / Graph API Explorer)
META_ACCESS_TOKEN=""

# Secret d'application Meta (Optionnel : pour valider la signature des Webhooks x-hub-signature-256)
META_APP_SECRET=""

# Jeton de vérification pour la souscription Webhook Meta (Optionnel : défini arbitrairement dans Meta for Developers)
META_VERIFY_TOKEN="leberceaudes3s_secret_webhook_token"
